# Normalmente você não precisa deste arquivo: crie a conta pela janela (botão "Criar conta")
# e o servidor grava o .env sozinho. Para fazer à mão, copie este arquivo para .env (que não vai para o git) e preencha.
# Usuário que pode entrar no sistema.
USUARIO=
# Hash da senha. Gere a linha pronta com: python -m scripts.gerar_hash
SENHA_HASH=
